# Copy to frontend/.env.local. Next.js loads .env.local and does not commit it.
# Every value here is a placeholder.

# Server-only. The /api/letta route sends this to Letta. Do not prefix it with NEXT_PUBLIC_.
LETTA_API_KEY=your-letta-api-key
# Optional. Defaults to https://api.letta.com inside the Letta provider.
# LETTA_BASE_URL=https://api.letta.com

# Browser-visible id of the Letta agent the chat page talks to (agent-<uuid>).
NEXT_PUBLIC_LETTA_AGENT_ID=agent-your-agent-id

# Base URL of the Python roadmap API (Flask). No trailing slash required.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Firebase web app config for roadmap documents in Cloud Firestore.
# Project settings → Your apps → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
