# Copy this file to backend/.env and fill in your own credentials.
# Never commit backend/.env. The values below are placeholders, not real keys.

# Letta (https://app.letta.com) — used by the voice-agent LLM adapter.
# Agent ids look like agent-<uuid>.
LETTA_API_KEY=your-letta-api-key
LETTA_AGENT_ID=agent-your-agent-id

# Tavus (https://www.tavus.io) — avatar plugin for the LiveKit voice agent.
TAVUS_API_KEY=your-tavus-api-key

# Deepgram (https://console.deepgram.com) — speech-to-text for the voice agent.
DEEPGRAM_API_KEY=your-deepgram-api-key

# LiveKit (https://cloud.livekit.io) — realtime room the voice agent joins.
# LIVEKIT_URL is the project WebSocket URL, for example wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
